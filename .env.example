# Variables de Entorno - Negocio Flex
# Copiar este archivo como .env para configuración local.

# Ambiente de ejecución: development | staging | production
VITE_APP_ENV=development

# Supabase (Credenciales públicas cliente - Anon Key)
# IMPORTANTE: NUNCA colocar claves Service Role o secretas aquí.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key

# GEMINI_API_KEY (Gestionado por el backend para funcionalidades de IA futuras)
GEMINI_API_KEY=
